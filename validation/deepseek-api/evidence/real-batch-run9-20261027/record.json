{
  "name": "rdkit-recap-terminal-fragments",
  "kind": "skill",
  "plan": {
    "name": "rdkit-recap-terminal-fragments",
    "task": "Extract unique terminal RECAP fragment SMILES and their RDKit molecule objects using RecapDecompose and GetLeaves.",
    "scope": "Molecular fragmentation with the supplied implementation and default settings. Accept valid, nonempty molecules; a SMILES adapter should reject blank input and failed parsing. Preserve wildcard attachment atoms. Empty leaves are valid and must not be replaced with the parent molecule. No descriptor calculation or chemical-validation claims.",
    "entrypoint": "In a Docker runtime with Python and RDKit, import Chem and Recap; parse and check the input; call root = Recap.RecapDecompose(mol), then leaves = root.GetLeaves(). Return sorted(leaves.keys()); access leaves[smi].mol when molecule objects are needed. Leave allNodes unset for independent inputs. root.children gives immediate products; root.GetAllChildren() gives all descendants.",
    "rationale": "Clarifies terminal versus intermediate fragments, unique identities versus occurrence counts, attachment markers, and valid empty results.",
    "construction": "Direct packaging of existing RDKit interfaces, source-derived examples and result interpretation, with optional mechanical input/output glue. No algorithm adaptation is required. Document prerequisites, adapter input boundaries and source provenance; retain applicable BSD notices for reproduced source. Explain that this implementation includes a rule marked outside the standard RECAP set.",
    "upstream_behavior": "Extract unique terminal RECAP fragment SMILES and their RDKit molecule objects using RecapDecompose and GetLeaves.",
    "added_behavior": "source-supported only",
    "kind": "skill",
    "needs": [],
    "selected": true,
    "priority": 0,
    "readiness": "callable",
