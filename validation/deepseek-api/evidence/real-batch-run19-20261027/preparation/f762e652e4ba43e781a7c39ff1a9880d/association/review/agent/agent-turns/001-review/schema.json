{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    },
    "resolution": {
      "type": "string",
      "enum": [
        "none",
        "revise_files",
        "supply_evidence"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "category": {
            "type": "string",
            "enum": [
              "file",
              "check",
              "source",
              "environment",
              "suggestion"
            ]
          }
        },
        "required": [
          "location",
          "problem",
          "evidence",
          "impact",
          "action",
          "blocking",
          "category"
        ]
      }
    },
    "oracle_changes_verified": {
      "type": "boolean"
    },
    "execution_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_assessment": {
      "type": "string",
      "enum": [
        "confirmed",
        "unknown",
        "conflict"
      ]
    },
    "binding_verified": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "resolution",
    "findings",
    "oracle_changes_verified",
    "execution_gaps",
    "requirement_assessment",
    "binding_verified"
  ]
}
