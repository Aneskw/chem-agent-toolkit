# Local DeepSeek configuration template for the structured (tool-free) model backend.
#
# Copy the workspace-root .env to `.env` in this directory, or create it from this
# template, then fill in the values locally. `.env` is git-ignored: never commit it,
# never paste its values into a prompt, log, fixture or report.
#
# Only these names are read. Values must come from the operator; this project never
# guesses a model name and never treats a third-party URL as the official service.

# Required. Bearer credential issued by the DeepSeek platform.
DEEPSEEK_API_KEY=

# Optional. Defaults to the official OpenAI-compatible base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required for a live call: the model identifier configured for this account.
# DEEPSEEK_MODEL=

# Optional. Set to 1 only when DEEPSEEK_BASE_URL deliberately points at a
# non-official host (for example a local test server). Recorded as a custom endpoint.
# DEEPSEEK_ALLOW_CUSTOM_ENDPOINT=0
