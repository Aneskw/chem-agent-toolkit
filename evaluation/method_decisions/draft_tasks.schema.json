        "required": ["id", "applicability", "request", "expected_behavior", "source_rule", "unseen_basis"],
        "properties": {
          "id": {"type": "string"},
          "applicability": {"type": "string", "enum": ["apply", "do_not_apply"]},
          "request": {"type": "string"},
          "expected_behavior": {"type": "string"},
          "source_rule": {"type": "string"},
          "unseen_basis": {"type": "string"}
        }
      }
    }
  }
}
